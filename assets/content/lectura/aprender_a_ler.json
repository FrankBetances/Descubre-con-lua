{
  "id": "aprender_a_ler",
  "avisoZeroPantalla": {
    "gl": "A conciencia fonolóxica é puramente acústica e táctil. O neno non precisa ver letras escritas aínda: o oído e o corpo son os primeiros lectores.",
    "es": "La conciencia fonológica es puramente acústica y táctil. La criatura no necesita ver letras escritas todavía: el oído y el cuerpo son los primeros lectores."
  },
  "actividadesConciencia": [
    {
      "id": "cf_01",
      "titulo": {
        "gl": "Palmas Silábicas co Corpo",
        "es": "Palmas Silábicas con el Cuerpo"
      },
      "subtitulo": {
        "gl": "Segmentación silábica con ritmo corporal",
        "es": "Segmentación silábica con ritmo corporal"
      },
      "descricion": {
        "gl": "Di palabras cotiás da casa (PA-TO, GA-TO, CA-SA) e bate palmas ou toca os pés por cada anaco. A crianza imita o teu movemento sen mirar a pantalla.",
        "es": "Di palabras cotidianas de la casa (PA-TO, GA-TO, CA-SA) y da palmadas o toca los pies por cada trozo. La criatura imita tu movimiento sin mirar la pantalla."
      },
      "tpr": {
        "gl": "1 golpe de palma por cada sílaba clara",
        "es": "1 golpe de palma por cada sílaba clara"
      }
    },
    {
      "id": "cf_02",
      "titulo": {
        "gl": "Caza de Rimas de Vigo",
        "es": "Caza de Rimas de Vigo"
      },
      "subtitulo": {
        "gl": "Discriminación do son final",
        "es": "Discriminación del sonido final"
      },
      "descricion": {
        "gl": "«Lúa quere unha cuncha na rúa». «O peixe salta e non se mexe». Xoga a rimar con obxectos reais. Riman cando soan igual ao final!",
        "es": "«Lúa quiere una concha en la calle». «El pez salta y no se mueve». Juega a rimar con objetos reales. ¡Riman cuando suenan igual al final!"
      },
      "tpr": {
        "gl": "Salto con xiro cando escoita a rima",
        "es": "Salto con giro cuando escucha la rima"
      }
    },
    {
      "id": "cf_03",
      "titulo": {
        "gl": "O Son Inicial Misterioso",
        "es": "El Sonido Inicial Misterioso"
      },
      "subtitulo": {
        "gl": "Illa de fonemas iniciais: /m/, /p/, /s/, /l/",
        "es": "Isla de fonemas iniciales: /m/, /p/, /s/, /l/"
      },
      "descricion": {
        "gl": "Pon varios obxectos diante: mazá, pan, sol. «Que empeza por /m/? /m/... mazá!». Toca a gorxa para sentir como vibra o son.",
        "es": "Pon varios objetos delante: manzana, pan, sol. «¿Qué empieza por /m/? /m/... ¡manzana!». Toca la garganta para sentir cómo vibra el sonido."
      },
      "tpr": {
        "gl": "Sinalar o obxecto e imitar o son /m/",
        "es": "Señalar el objeto e imitar el sonido /m/"
      }
    }
  ],
